{
  "name": "twitch-multiplayer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "echo '🔄 Freeing port 5173'; fuser -k 5173/tcp 2>/dev/null || true",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "inspect": "node scripts/inspect-build.mjs"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
